# Configuración SSH para scripts/publicar.sh.
#
# Copiar este archivo a scripts/publicar.env y rellenar los valores.
# publicar.env está en .gitignore y NUNCA debe commitearse: la cuenta de
# hosting es el activo crítico de este sitio (ver el vault de 1d-ads,
# postura-de-seguridad-del-sitio).
#
# Para que funcione hace falta, una sola vez:
#   1. Activar SSH en el hosting: cPanel → «SSH Access» → Enable.
#   2. Autorizar tu clave pública: cPanel → SSH Access → Manage SSH Keys →
#      Import + Authorize, o bien `ssh-copy-id <DESTINO>`.
#   3. Probar a mano: `ssh <DESTINO>` debe entrar sin pedir contraseña.

# Usuario y host SSH, como en `ssh usuario@host`. El usuario es el de cPanel;
# el host es el dominio o la IP del hosting (50.63.7.199).
DESTINO="usuario@1d-solutions.com"

# Carpeta del servidor donde vive el sitio. Vale ~ (se expande en el servidor)
# o una ruta absoluta tipo /home/usuario/public_html.
RUTA_REMOTA="~/public_html"
